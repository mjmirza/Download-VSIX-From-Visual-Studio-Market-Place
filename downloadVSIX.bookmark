javascript:(function(){function u(p,e,v,t){var s="https://marketplace.visualstudio.com/_apis/public/gallery/publishers/"+encodeURIComponent(p)+"/vsextensions/"+encodeURIComponent(e)+"/"+encodeURIComponent(v)+"/vspackage";if(t){s+="?targetPlatform="+encodeURIComponent(t)}return s}var i;try{i=new URL(location.href).searchParams.get("itemName")}catch(e){i=null}if(!i||i.indexOf(".")<0){alert("Open a marketplace extension page first. The page URL needs an itemName value.");return}var d=i.indexOf("."),p=i.slice(0,d),x=i.slice(d+1);fetch("https://marketplace.visualstudio.com/_apis/public/gallery/extensionquery",{method:"POST",headers:{"Accept":"application/json;api-version=3.0-preview.1","Content-Type":"application/json"},body:JSON.stringify({filters:[{criteria:[{filterType:7,value:i}]}],flags:1})}).then(function(r){if(!r.ok){throw new Error("status "+r.status)}return r.json()}).then(function(j){var ext=j.results[0].extensions[0],vs=ext.versions,L=vs[0].version,P=[];vs.forEach(function(v){if(v.version===L&&v.targetPlatform&&P.indexOf(v.targetPlatform)<0){P.push(v.targetPlatform)}});if(P.length===0){location.href=u(p,x,L)}else{var c=P.sort().map(function(t){return t+"  "+u(p,x,L,t)}).join("\n");alert(i+" "+L+" ships a separate build per platform. Direct URLs.\n\n"+c)}}).catch(function(err){alert("Could not build the download. "+err.message)})})();
